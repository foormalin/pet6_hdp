# Copy to .env before the first start. Never commit .env.
COMPOSE_PROJECT_NAME=helpdesk
TZ=Europe/Moscow

# Published endpoints. Keep BIND_ADDRESS on loopback for a local demo.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Application database. Generate new passwords before any non-local use.
GLPI_DB_HOST=db
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=change_me_glpi_32_chars
MARIADB_ROOT_PASSWORD=change_me_root_32_chars

# Read-only account used by mysqld_exporter.
METRICS_DB_USER=exporter
METRICS_DB_PASSWORD=change_me_metrics_32_chars

# Grafana bootstrap administrator.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_32_chars

# Version pins. Update deliberately and validate with GitHub Actions.
GLPI_IMAGE=glpi/glpi:11.0.11
MARIADB_IMAGE=mariadb:11.8
NGINX_IMAGE=nginx:1.28-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.13.3
GRAFANA_IMAGE=grafana/grafana:13.2.2
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.27.0
MYSQLD_EXPORTER_IMAGE=prom/mysqld-exporter:v0.20.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.55.1
ALPINE_IMAGE=alpine:3.22
